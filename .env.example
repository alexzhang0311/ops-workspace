# Copy to .env. This file is read by sh server.sh. Keep mode 600.
OPS_HOST='127.0.0.1'
OPS_PORT='8765'
OPS_BASE_URL='http://127.0.0.1:8765'
# Offline installer sets the PostgreSQL URL. SQLite is local development only.
# OPS_DATABASE_URL='postgresql+psycopg://ops:URL_ENCODED_PASSWORD@127.0.0.1:55432/opsstudio'
OPS_MAX_CONCURRENCY='32'
OPS_PER_USER_CONCURRENCY='16'
OPS_LOG_LIMIT_BYTES='10485760'
# Optional internal AI CA certificate bundle (PEM), retaining TLS verification.
# OPS_AI_CA_BUNDLE='/data/app/certs/internal-ca.pem'
# Optional colon-separated roots available to the administrator AI initialization page.
# When omitted, any absolute path readable by the trusted shared app account is available.
# OPS_SCRIPT_IMPORT_ROOTS='/data/app/scripts:/opt/company/monitor'
